# Database connection string
# For local development: postgresql://username:password@localhost:5432/prediction_game
# For Railway: They provide this automatically
DATABASE_URL="postgresql://username:password@localhost:5432/prediction_game"

# Server port
PORT=3001

# Solana RPC endpoint (for checking token balances)
# Free public endpoint for development, use paid one for production
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Platform token mint address (replace with your pump.fun token once launched)
TOKEN_MINT_ADDRESS=""

# Minimum token balance to be considered a "holder"
MIN_TOKEN_BALANCE="1"

# Admin wallet address (for airdrop functionality)
ADMIN_WALLET_ADDRESS="YOUR_ADMIN_WALLET_ADDRESS"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Polymarket API base URL
POLYMARKET_API_URL="https://gamma-api.polymarket.com"
